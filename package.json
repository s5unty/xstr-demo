{
  "name": "threejs-quickcode-typing-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:lexicon": "node scripts/build-lexicon.mjs",
    "dev": "pnpm run build:lexicon && vite",
    "build": "pnpm run build:lexicon && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:build": "rm -rf .tmp-test && tsc -p tsconfig.testbuild.json && printf '{\"type\":\"commonjs\"}' > .tmp-test/package.json",
    "test:run": "node --test tests/session-regression.test.cjs",
    "test": "pnpm run build:lexicon && pnpm run test:build && pnpm run test:run"
  },
  "dependencies": {
    "three": "^0.181.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
